apps/pwa/android/**/build
apps/pwa/android/.gradle

# ACHTUNG: `*.apk` und `deploy/apk/apks` hier NICHT ausschliessen —
# fly.apk.toml baut mit dem Repo-Root als Kontext und diesem .dockerignore;
# deploy/apk/Dockerfile kopiert die APKs aus deploy/apk/apks/.
